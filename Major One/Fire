<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://portals-labs.github.io/portals-sdk/portals-sdk.js?v=10005456"></script>
  <title>Extinguish Fire</title>
  <style>
    html, body { margin:0; padding:0; width:100%; height:100%; background:transparent; overflow:hidden; }
    canvas { display:block; width:100%; height:100%; cursor:none; touch-action:none; }
  </style>
</head>
<body>
  <canvas id="c"></canvas>
  <script>
  (() => {
    // ---- CONFIG ----
    const DURATION = 8000; // ms — fire always goes out over this time, then closes

    const canvas = document.getElementById('c');
    const ctx = canvas.getContext('2d');

    let W, H, cx, cy, scale, baseY;
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth; H = window.innerHeight;
      canvas.width = W*dpr; canvas.height = H*dpr;
      canvas.style.width = W+'px'; canvas.style.height = H+'px';
      ctx.setTransform(dpr,0,0,dpr,0,0);
      cx = W/2; cy = H/2; scale = Math.min(W,H)/620;
      baseY = cy + 90*scale;   // where the fire mass sits
      buildSources();
    }
    window.addEventListener('resize', resize);

    const mouse = { x:-999, y:-999, down:false, active:false };
    // fire = a front-facing cluster of emitters (roughly elliptical mass facing the camera)
    let sources = [];
    let flames = [], embers = [], smoke = [], foam = [];
    let shakeMag = 0;
    let startTime = 0, done = false, steamGlow = 0;
    let intensity = 1;

    function buildSources() {
      sources = [];
      const n = 14; let seed = 55;
      const rnd = () => { seed=(seed*9301+49297)%233280; return seed/233280; };
      const rx = 150*scale, ry = 60*scale;
      for (let i=0;i<n;i++){
        // scatter emitters inside an ellipse so the flames form a bulging front-on mass
        const a = rnd()*Math.PI*2;
        const rr = Math.sqrt(rnd());
        const ex = Math.cos(a)*rr, ey = Math.sin(a)*rr;
        sources.push({
          x: cx + ex*rx,
          y: baseY + ey*ry,
          // bigger + hotter toward the centre so the middle billows toward the viewer
          size: (0.6 + (1-rr)*0.9),
          depth: 1 - rr*0.5,
          phase: rnd()*Math.PI*2,
          local: 1
        });
      }
    }

    // input (optional — outcome does not depend on it)
    function pt(e){
      const r = canvas.getBoundingClientRect();
      const t = e.touches ? e.touches[0] : e;
      mouse.x = t.clientX-r.left; mouse.y = t.clientY-r.top; mouse.active = true;
    }
    canvas.addEventListener('mousemove', pt);
    canvas.addEventListener('mousedown', e=>{ mouse.down=true; pt(e); });
    window.addEventListener('mouseup', ()=> mouse.down=false);
    canvas.addEventListener('touchstart', e=>{ mouse.down=true; pt(e); e.preventDefault(); }, {passive:false});
    canvas.addEventListener('touchmove',  e=>{ pt(e); e.preventDefault(); }, {passive:false});
    window.addEventListener('touchend', ()=> mouse.down=false);

    function closePortal(){
      if (typeof PortalsSdk !== 'undefined' && typeof PortalsSdk.closeIframe === 'function') PortalsSdk.closeIframe();
      else console.warn("PortalsSdk.closeIframe() unavailable in this environment.");
    }

    const rnd = () => Math.random();

    function update(dt, progress){
      intensity = 1 - progress; // time-driven: fire always dies out
      shakeMag *= 0.9;

      for (const s of sources){
        s.local += (1 - s.local)*dt*0.6;
        const life = Math.max(0, intensity) * s.local * s.size;
        if (life > 0.03 && rnd() < life*1.0){
          flames.push({
            x: s.x + (rnd()-0.5)*30*scale,
            y: s.y + (rnd()-0.5)*10*scale,
            vy: -(1.3+rnd()*1.7)*scale,
            vx: (rnd()-0.5)*0.6*scale,
            life: 1, max: 0.5+life,
            size: (16+rnd()*26)*scale*(0.5+life)*s.depth,
            hue: 16 + rnd()*30,
            wob: rnd()*Math.PI*2
          });
        }
        if (life > 0.05 && rnd() < life*0.5){
          embers.push({ x:s.x+(rnd()-0.5)*34*scale, y:s.y, vx:(rnd()-0.5), vy:-(1.5+rnd()*2.2)*scale, life:1, hue:30+rnd()*20 });
        }
        if (rnd() < (0.12 + (1-intensity)*0.45)*life + 0.015){
          smoke.push({ x:s.x+(rnd()-0.5)*34*scale, y:s.y-20*scale, vx:(rnd()-0.5)*0.4, vy:-(0.6+rnd()*0.9)*scale, life:1, size:(22+rnd()*32)*scale });
        }
      }

      for (const f of flames){ f.x+=f.vx; f.y+=f.vy; f.vy*=0.99; f.wob+=0.2; f.x+=Math.sin(f.wob)*0.6; f.life-=dt*(1.6/f.max); }
      flames = flames.filter(f=>f.life>0);
      for (const e of embers){ e.x+=e.vx; e.y+=e.vy; e.vy+=0.02; e.life-=dt*1.1; }
      embers = embers.filter(e=>e.life>0);
      for (const sm of smoke){ sm.x+=sm.vx; sm.y+=sm.vy; sm.vy*=0.99; sm.size+=12*scale*dt; sm.life-=dt*0.5; }
      smoke = smoke.filter(s=>s.life>0);

      // extinguisher spray (cosmetic): cone of foam from the cursor toward the fire centre
      if (mouse.down && mouse.active && progress < 1){
        const ang = Math.atan2(baseY - mouse.y, cx - mouse.x);
        for (let i=0;i<5;i++){
          const a = ang + (rnd()-0.5)*0.5;
          const sp = (6+rnd()*5)*scale;
          foam.push({ x:mouse.x, y:mouse.y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp, life:1, size:(6+rnd()*8)*scale });
        }
        for (const s of sources){
          if (Math.hypot(mouse.x-s.x, mouse.y-s.y) < 140*scale) s.local = Math.max(0.12, s.local - dt*1.6);
        }
      }
      for (const p of foam){ p.x+=p.vx; p.y+=p.vy; p.vy+=0.15*scale; p.vx*=0.97; p.size+=10*scale*dt; p.life-=dt*1.6; }
      foam = foam.filter(p=>p.life>0);

      if (progress >= 1 && !done){
        done = true; steamGlow = 1; shakeMag = 3;
        for (let i=0;i<28;i++){ const s=sources[i%sources.length]; smoke.push({ x:s.x+(rnd()-0.5)*40*scale, y:s.y, vx:(rnd()-0.5)*1.2, vy:-(0.5+rnd())*scale, life:1, size:(26+rnd()*30)*scale }); }
        setTimeout(closePortal, 650);
      }
      if (steamGlow>0) steamGlow -= dt*1.4;
    }

    function draw(){
      const ox=(Math.random()-0.5)*shakeMag, oy=(Math.random()-0.5)*shakeMag;
      ctx.clearRect(0,0,W,H);          // fully transparent — overlays whatever is behind
      ctx.save(); ctx.translate(ox,oy);

      const gi = Math.max(0, intensity);

      // soft warm haze around the fire (additive so it tints, never darkens the game behind)
      ctx.globalCompositeOperation='lighter';
      const glow = ctx.createRadialGradient(cx, baseY-20*scale, 10, cx, baseY-20*scale, 300*scale);
      glow.addColorStop(0,`rgba(255,120,40,${0.28*gi})`);
      glow.addColorStop(1,'rgba(255,120,40,0)');
      ctx.fillStyle=glow; ctx.beginPath(); ctx.arc(cx, baseY-20*scale, 300*scale, 0, 7); ctx.fill();
      ctx.globalCompositeOperation='source-over';

      // smoke behind flames
      for (const sm of smoke){
        ctx.globalAlpha = sm.life*0.26;
        const sg = ctx.createRadialGradient(sm.x,sm.y,0,sm.x,sm.y,sm.size);
        sg.addColorStop(0,'rgba(120,125,135,1)'); sg.addColorStop(1,'rgba(120,125,135,0)');
        ctx.fillStyle=sg; ctx.beginPath(); ctx.arc(sm.x,sm.y,sm.size,0,7); ctx.fill();
      }
      ctx.globalAlpha=1;

      // flames (additive glow)
      ctx.globalCompositeOperation='lighter';
      for (const f of flames){
        const a = Math.max(0,f.life);
        const fg = ctx.createRadialGradient(f.x,f.y,0,f.x,f.y,f.size);
        fg.addColorStop(0,`hsla(${f.hue+15},100%,75%,${a})`);
        fg.addColorStop(.4,`hsla(${f.hue},100%,55%,${a*0.8})`);
        fg.addColorStop(1,`hsla(${f.hue-10},100%,45%,0)`);
        ctx.fillStyle=fg; ctx.beginPath(); ctx.arc(f.x,f.y,f.size,0,7); ctx.fill();
      }
      for (const e of embers){
        ctx.globalAlpha=Math.max(0,e.life);
        ctx.fillStyle=`hsl(${e.hue},100%,60%)`;
        ctx.beginPath(); ctx.arc(e.x,e.y,2*e.life+0.5,0,7); ctx.fill();
      }
      ctx.globalAlpha=1;
      ctx.globalCompositeOperation='source-over';

      // extinguisher foam
      for (const p of foam){
        ctx.globalAlpha=Math.max(0,p.life)*0.85;
        const pg=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.size);
        pg.addColorStop(0,'rgba(240,248,255,1)'); pg.addColorStop(1,'rgba(210,225,240,0)');
        ctx.fillStyle=pg; ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,7); ctx.fill();
      }
      ctx.globalAlpha=1;

      // final steam flash
      if (steamGlow>0){
        ctx.globalAlpha=Math.max(0,steamGlow)*0.5;
        const st=ctx.createRadialGradient(cx,baseY-20*scale,10,cx,baseY-20*scale,260*scale);
        st.addColorStop(0,'rgba(235,240,245,.9)'); st.addColorStop(1,'rgba(235,240,245,0)');
        ctx.fillStyle=st; ctx.beginPath(); ctx.arc(cx,baseY-20*scale,260*scale,0,7); ctx.fill();
        ctx.globalAlpha=1;
      }

      // extinguisher nozzle cursor
      if (mouse.active && !done){
        const r=20*scale;
        ctx.save();
        ctx.translate(mouse.x, mouse.y);
        const ang = Math.atan2(baseY - mouse.y, cx - mouse.x);
        ctx.rotate(ang);
        ctx.fillStyle='#333';
        ctx.fillRect(r-2, -4*scale, 16*scale, 8*scale);
        ctx.rotate(-ang);
        ctx.fillStyle='#c62828'; ctx.strokeStyle='#eee'; ctx.lineWidth=2;
        ctx.beginPath(); ctx.arc(0,0,r,0,7); ctx.fill();
        ctx.beginPath(); ctx.arc(0,0,r,0,7); ctx.stroke();
        ctx.restore();
        if (mouse.down){
          ctx.strokeStyle='rgba(240,248,255,.4)'; ctx.lineWidth=1.5;
          ctx.beginPath(); ctx.arc(mouse.x,mouse.y,r+6,0,7); ctx.stroke();
        }
      }

      ctx.restore();
    }

    let lastT=0;
    function loop(t){
      if (!startTime) startTime = t;
      const dt = Math.min(0.05,(t-lastT)/1000)||0; lastT=t;
      const progress = Math.min((t-startTime)/DURATION, 1);
      update(dt, progress);
      draw();
      if (!done || steamGlow > -0.5 || flames.length || smoke.length) requestAnimationFrame(loop);
    }

    resize();
    requestAnimationFrame(loop);
  })();
  </script>
</body>
</html>
